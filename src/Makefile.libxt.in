# -*- Makefile -*-

abs_top_srcdir  = @abs_top_srcdir@

prefix          = @prefix@
exec_prefix     = @exec_prefix@
libexecdir      = @libexecdir@
xtlibdir        = @xtlibdir@

CC              = @CC@
CCLD            = ${CC}
CFLAGS          = @CFLAGS@
LDFLAGS         = @LDFLAGS@

libxtables_CFLAGS = @libxtables_CFLAGS@
libxtables_LIBS   = @libxtables_LIBS@
AM_DEPFLAGS     = -Wp,-MMD,$(@D)/.$(@F).d,-MT,$@

TARGETS = libxt_WGOBFS.so libxt_WGANYCAST.so

.PHONY: all install clean
all: ${TARGETS}

install:
	for t in ${TARGETS}; do \
		install -pm0755 $$t "${DESTDIR}/${xtlibdir}"; \
	done

clean:
	rm -f *.oo *.so;

%.so: %.oo
	${CCLD} ${AM_LDFLAGS} -shared ${LDFLAGS} -o $@ $< ${libxtables_LIBS} ${LDLIBS}

%.oo: %.c
	${CC} ${AM_DEPFLAGS} ${AM_CPPFLAGS} ${AM_CFLAGS} -DPIC -fPIC ${CPPFLAGS} ${CFLAGS} -o $@ -c $< ${libxtables_CFLAGS}
